{
  "name": "networth-tracker-v2",
  "version": "2.3.3",
  "description": "NetWorth Tracker v2 - v1 feature-parity rebuild",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:electron\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron .",
    "build:client": "vite build",
    "start": "electron .",
    "pack": "npm run build:client && electron-builder --dir",
    "dist": "npm run build:client && electron-builder"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@vitejs/plugin-react": "latest",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "dropbox": "^10.46.0",
    "electron-updater": "^6.8.9",
    "express": "^4.21.0",
    "googleapis": "^181.0.0",
    "html2pdf.js": "^0.14.0",
    "jsonwebtoken": "^9.0.3",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "sql.js": "^1.11.0",
    "vite": "latest"
  },
  "devDependencies": {
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.networth.tracker",
    "productName": "NetWorth Tracker",
    "directories": {
      "output": "release-latest"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DX101",
        "repo": "Networth-tracker"
      }
    ],
    "files": [
      "electron/**/*",
      "server/**/*",
      "client/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "NetWorth-Tracker-Setup-${version}.${ext}"
    }
  }
}
